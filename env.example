# Renomeie este arquivo para .env e preencha (só necessário pra rodar LOCAL;
# em produção as variáveis vêm da stack do Portainer)

# ---- Servidor ----
PORT=3000

# ---- WAHA (WhatsApp HTTP API) ----
WAHA_URL=https://wh.atendenexo.com.br
WAHA_SESSION=telhas
WAHA_API_KEY=

# ---- IA (OpenAI) — OPCIONAL: interpreta texto livre do cliente.
# Vazio = bot funciona só com menus numerados (sem custo de tokens).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Fonte de preços: "local" (catalogo.json) ou "gestaoclick" (futuro) ----
PRICING_SOURCE=local

# ---- GestãoClick (preencher quando contratar a API) ----
GC_ACCESS_TOKEN=
GC_SECRET_TOKEN=

# ---- Painel interno (obrigatório para acessar /painel e os PDFs) ----
# Sem esta senha o painel fica desativado. Os orçamentos têm dados pessoais
# de clientes — nunca deixe em branco em produção.
PAINEL_SENHA=

# ---- Empresa (aparece no PDF) ----
EMPRESA_NOME=Sua Empresa de Telhas LTDA
EMPRESA_TELEFONE=(31) 99999-9999
EMPRESA_CIDADE=Belo Horizonte - MG
